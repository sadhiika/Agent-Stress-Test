# ---- Provider switches ----
# stub = offline, no GCP needed. vertex = real Gemini.
GENERATOR_PROVIDER=stub
JUDGE_PROVIDER=stub
# stub = built-in toy target. http = call a real endpoint.
TARGET_MODE=stub
TARGET_URL=

# ---- GCP / Vertex (only when providers=vertex) ----
GCP_PROJECT=
GCP_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-pro

# ---- Langfuse (only when ENABLE_TRACING=1) ----
ENABLE_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Run parameters ----
CASES_PER_CATEGORY=2
CRITIC_THRESHOLD=0.7
